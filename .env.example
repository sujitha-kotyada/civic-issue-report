# === AI / Vision ===
# AI service endpoint (OpenAI, Azure OpenAI, Hugging Face, Google etc).
AI_SERVICE_URL=
# API key for the AI service (keep secret, server-side only)
AI_API_KEY=
# Model or deployment name (e.g. gpt-4o, text-vision-1, my-deployment)
AI_MODEL=
# Optional provider id: openai|azure|huggingface|google
AI_PROVIDER=

# === Image storage / upload ===
# URL used by client to upload images (or your server presign endpoint)
IMAGE_UPLOAD_URL=
# Object storage bucket name (S3/GCS) if used server-side
STORAGE_BUCKET=
# Server-side storage creds (use secret manager in production)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# === Database (server-side only) ===
# Full MongoDB connection string (do NOT expose client-side)
MONGODB_URI=
# Supabase project URL and anon/public key (anon key is public but keep server key secret)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Backend / App URLs ===
# Base URL of your API (serverless or server)
API_BASE_URL=
# If you run an AI microservice separate from API
AI_FUNCTION_URL=

# === Firebase (if you use Firebase on client) - non-secret fields are okay
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# === Provider-specific extras (placeholders) ===
# Hugging Face (if using HF inference API)
HUGGINGFACE_API_KEY=
# Google Cloud / Gemini API key or OAuth client id (if using)
GOOGLE_API_KEY=

# === Security / runtime ===
# Comma separated allowed origins for CORS
CORS_ORIGINS=
# JWT secret for server-signed tokens
JWT_SECRET=
# Confidence threshold to accept auto-labeling
AI_CONFIDENCE_THRESHOLD=0.7

# === Observability / optional ===
SENTRY_DSN=

# NOTES:
# - NEVER commit a file containing real secrets. Use this file as a template only.
# - Put real values into a local `.env` (gitignored) or a secret manager in production.
